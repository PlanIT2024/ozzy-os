ANTHROPIC_API_KEY=
BIT_MODEL=claude-sonnet-5
DISCORD_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=
BIT_CHANNEL_ID=
OWNER_DISCORD_ID=
TZ=America/New_York
NODE_HUB_PORT=8787
NODE_HUB_BIND=127.0.0.1
NODE_TOKENS=
BIT_MONTHLY_CAP_USD=25

# Node process (can share this file when both run on OZZY-AI)
BRAIN_URL=ws://127.0.0.1:8787
NODE_TOKEN=
MACHINE_NAME=OZZY-AI

# Phase 2: same E2E layer for loopback and relay
NODE_TRANSPORT=local
NODE_KEYS=
BRAIN_PUBLIC_KEY=
# Optional overrides; default keys live in data/keys/{brain,node}.json
# BRAIN_KEY_FILE=
# NODE_KEY_FILE=
# Remote relay (leave empty for local-only brain)
RELAY_URL=
RELAY_TOKEN=
# On a shared brain+node .env, use separate relay tokens:
BRAIN_RELAY_TOKEN=
NODE_RELAY_TOKEN=
AUTO_PUSH=false

# Phase 3 web tool invocations (persisted daily/monthly usage)
BIT_DAILY_SEARCH_CAP=50
BIT_DAILY_FETCH_CAP=100

# Phase 5: opt in on each node; restart that node after changing.
SCREEN_ENABLED=false
BIT_DAILY_SCREEN_CAP=40

# Phase 6: shell-equivalent input, disabled unless explicitly enabled per node.
CONTROL_ENABLED=false
# Comma-separated case-insensitive app/window matches blocked at the node.
CONTROL_BLOCKED_APPS=discord
CONTROL_LOG_TEXT=false
BIT_CONTROL_MAX_ACTIONS=40

[Unit]
Description=bIT OZZY OS always-on brain
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/ozzy-os
EnvironmentFile=%h/ozzy-os/.env
ExecStart=/usr/bin/node %h/ozzy-os/src/brain/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
UMask=0077

[Install]
WantedBy=default.target
